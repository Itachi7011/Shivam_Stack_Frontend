# Shivam Stack Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.
#
# Note: this file was reconstructed from actual `import.meta.env.VITE_*`
# usages found in the codebase (a .env.example did not exist in the repo,
# likely because "*.local" / ".env" patterns in .gitignore excluded it).
# No values below are secrets — they are all public-facing display/config
# values already visible in the shipped frontend bundle.

# ----------------------------------------------------------------------------
# API / Backend connection
# ----------------------------------------------------------------------------

# Base URL of the backend API and Socket.io server.
# Used in: src/main.jsx, src/hooks/useSocket.js, src/services/socketApi.js
# Dev example:  http://localhost:5000
# Prod example: https://shivam-stack-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Environment flag consumed directly in src/main.jsx to pick the axios
# base URL. Current code checks for the literal string "deployment".
# Documented as-is; see docs/development.md for the exact logic.
VITE_NODE_ENV=development

# ----------------------------------------------------------------------------
# Public contact details
# Used in: Footer, Home, Contact, BookFreeCall pages
# ----------------------------------------------------------------------------

VITE_Email=hello@shivamstack.com
VITE_Mobile=

# ----------------------------------------------------------------------------
# Social links
# ----------------------------------------------------------------------------

VITE_Github=https://github.com/shivamstack
VITE_Twitter=https://twitter.com/shivamstack
VITE_LinkedIn=https://linkedin.com/in/shivamstack
VITE_Insta=
VITE_Facebook=
VITE_Whatsapp=
VITE_Youtube=https://youtube.com/@shivamstack

# ----------------------------------------------------------------------------
# Booking / resume
# ----------------------------------------------------------------------------

# Calendly booking link, used on the Home page.
VITE_CALENDLY_URL=https://calendly.com

# Resume file URL or local path (e.g. /resume.pdf), used on the Home page.
VITE_RESUME_URL=/resume.pdf
